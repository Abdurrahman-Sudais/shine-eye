# Copy to .env.local and fill in. Never commit .env.local.

# --- Gemini (verdict, screenshots, voice notes, embeddings) — free tier ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated, tried in order on overload/timeout
LLM_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
LLM_MODELS_CHEAP=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_TIMEOUT_MS=10000
EMBED_MODEL=gemini-embedding-2-preview

# --- Supabase (community reports + pgvector) ---
# Project Settings → API. The service role key is server-only; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- URL reputation (optional; checks are skipped when empty) ---
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# https://auth.abuse.ch/ (free Auth-Key for URLhaus)
URLHAUS_AUTH_KEY=

# --- Rate limiting (requests per IP per minute on /api/analyze) ---
RATE_LIMIT_PER_MINUTE=10
