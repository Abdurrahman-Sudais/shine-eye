# Copy to .env.local and fill in. Never commit .env.local.

# --- LLM (verdict + screenshot vision) ---
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MODEL_CHEAP=claude-haiku-4-5

# --- Gemini (voice-note transcription + embeddings) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Supabase (community reports + pgvector) ---
# Project Settings → API. The service role key is server-only; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- URL reputation (optional; checks are skipped when empty) ---
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# https://auth.abuse.ch/ (free Auth-Key for URLhaus)
URLHAUS_AUTH_KEY=

# --- Rate limiting (requests per IP per minute on /api/analyze) ---
RATE_LIMIT_PER_MINUTE=10
